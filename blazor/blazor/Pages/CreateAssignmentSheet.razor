@page "/create-assignment-sheet"
@using blazor.models
@using Shared
@inject HttpClient Http
@inject NavigationManager Navigation
@attribute [Authorize(Roles = Roles.Teacher)]

<h3>Lav opgavesæt</h3>

<div class="container">

    <div class="box">
        <div class="mb-2">
            <label>Titel</label>
            <input class="form-control" @bind="dto.Title" />
        </div>

        <div class="mb-2">
            <label>Fag</label>
            <input class="form-control" @bind="dto.Subject" />
        </div>

        <div class="mb-2">
            <label>Niveau</label>
            <input class="form-control" @bind="dto.Level" />
        </div>

        <div class="mb-2">
            <label>År</label>
            <input class="form-control" type="number" @bind="dto.Year" />
        </div>

        <div class="mb-2">
            <label>Ejer</label>
            <input class="form-control" @bind="dto.Owner" />
        </div>

        <button class="btn btn-success mt-2"
                @onclick="SaveAssignmentSheet"
                disabled="@string.IsNullOrWhiteSpace(dto.Title)">
            Gem opgavesæt
        </button>

        @if (!string.IsNullOrWhiteSpace(status))
        {
            <p class="mt-2">@status</p>
        }
    </div>

</div>

@code {
    private CreateAssignmentSheetDto dto = new();
    private string status = "";

    private async Task SaveAssignmentSheet()
    {
        var response = await Http.PostAsJsonAsync("api/assignmentsheet", dto);

        if (response.IsSuccessStatusCode)
        {
            status = $"Opgavesæt '{dto.Title}' oprettet.";
            dto = new CreateAssignmentSheetDto();
            await Task.Delay(1500);
            Navigation.NavigateTo("/assignment-sheet-overview");
        }
        else
        {
            status = await response.Content.ReadAsStringAsync();
        }
    }
}
