@page "/edit-assignment-sheet"

<h1 class="title">Ret opgavesæt</h1>

<div class="page-container">

    <!-- Top dropdowns -->
    <div class="top-controls">
        <select>
            <option>Vælg Hold</option>
        </select>

        <select>
            <option>Vælg Elev</option>
        </select>

        <select>
            <option>Vælg Opgavesæt</option>
        </select>
    </div>

    <!-- Opgaver -->
    <div class="opgaver-container">

        <!-- Opgave 1 -->
        <div class="opgave-block">
            <div class="opgave-header">
                <span>Opgave 1a</span>
            </div>

            <div class="opgave-box">Opgave</div>

            <div class="opgave-inputs">
                <input type="text" placeholder="Vurdering" />
                <input type="text" placeholder="Fejlkoder" />
                <textarea placeholder="Kommentar"></textarea>
            </div>
        </div>

        <!-- Opgave 2 -->
        <div class="opgave-block">
            <div class="opgave-header">
                <span>Opgave 2a</span>
            </div>

            <div class="opgave-box">Opgave</div>

            <div class="opgave-inputs">
                <input type="text" placeholder="Vurdering" />
                <input type="text" placeholder="Fejlkoder" />
                <textarea placeholder="Kommentar"></textarea>
            </div>
        </div>

    </div>

    <!-- Afslut -->
    <div class="footer">
        <button class="afslut-btn">Afslut</button>
    </div>

</div>