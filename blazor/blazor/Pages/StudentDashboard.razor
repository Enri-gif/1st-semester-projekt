@page "/student-dashboard"
@using Shared.Contracts
@using Shared
@using blazor.models
@using Microsoft.AspNetCore.Components.Web
@using System.Net.Http.Json
@attribute [Authorize(Roles = Roles.Student)]
@inject HttpClient Http

<PageTitle>Student Dashboard</PageTitle>

<h1>Student Dashboard</h1>

<div class="controls">
    <input placeholder="Søgfelt..."
           @bind="searchText" />

    <select @onchange="SortChanged">
        <option value="date">Sorter efter dato</option>
        <option value="subject">Sorter efter fag</option>
    </select>

    <button class="nav-button" @onclick="GoToStatistics">Se Statistik</button>
</div>

<p>Filtered count: @FilteredAssignments.Count()</p>

<div class="assignment-container">
    @foreach (var assignment in FilteredAssignments)
    {
        <div class="assignment-row">
            <div class="assignment-col subject">
                @assignment.Subject
            </div>

            <div class="assignment-col topic">
                @assignment.Topic
            </div>

            <div class="assignment-col date">
                @assignment.Date.ToShortDateString()
            </div>

            <div class="assignment-col owner">
                @assignment.Owner
            </div>

            <div class="assignment-col button-col">
                <button class="assignment-button">Se Opgave</button>
            </div>
        </div>
    }
</div>

@if (showChangePassword)
{
    <div>
        <div class="change-password-box">
            <h3>Ændre adgangskode</h3>

            <input type="password" @bind="oldPassword" placeholder="Nuværende adgangskode" />
            <input type="password" @bind="newPassword" placeholder="Ny adgangskode" />

            <button class="save-password-button" @onclick="Change_Password">Gem ændring</button>
        </div>

        @if (!string.IsNullOrEmpty(passwordChangeError))
        {
            <p>@passwordChangeError</p>
        }
    </div>
}

@code {
    [Inject]
    private NavigationManager Navigation { get; set; } = default!;

    private List<Assignment> assignments = new();
    private string searchText = string.Empty;
    private string currentSort = "date";

    private bool showChangePassword = false; // To not show it briefly when navigating back to the student dashboard
    private string oldPassword = "";
    private string newPassword = "";
    private string? passwordChangeError;

    private void GoToStatistics()
    {
        Navigation.NavigateTo("/statistik-elev");
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadAssignmentsAsync();

        showChangePassword = await Http.GetFromJsonAsync<bool>(
            "api/account/password-firstchanged-status"
        );
    }

    private async Task LoadAssignmentsAsync()
    {
        try
        {
            var paged = await Http.GetFromJsonAsync<PagedResult<Assignment>>("api/assignment?pageSize=100");
            assignments = paged?.Items ?? new List<Assignment>();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Failed to load assignments: {ex.Message}");
        }
    }

    private IEnumerable<Assignment> FilteredAssignments
    {
        get
        {
            var query = assignments.AsEnumerable();

            if (!string.IsNullOrWhiteSpace(searchText))
            {
                query = query.Where(a =>
                    a.Subject.Contains(searchText, StringComparison.OrdinalIgnoreCase) ||
                    a.Topic.Contains(searchText, StringComparison.OrdinalIgnoreCase));
            }

            query = currentSort switch
            {
                "subject" => query.OrderBy(a => a.Subject),
                _ => query.OrderBy(a => a.Date)
            };

            return query;
        }
    }

    private void SortChanged(ChangeEventArgs e)
    {
        currentSort = e.Value?.ToString() ?? "date";
    }

    async Task Change_Password ()
    {
        passwordChangeError = null;

        var response = await Http.PostAsJsonAsync("api/account/change-password", new
        {
            OldPassword = oldPassword,
            NewPassword = newPassword
        });

        if (response.IsSuccessStatusCode)
        {
            showChangePassword = false;
        }
        else
        {
            var errors = await response.Content.ReadFromJsonAsync<string[]>();
            passwordChangeError = errors?.FirstOrDefault() ?? "Password change failed";
        }
    }

}
