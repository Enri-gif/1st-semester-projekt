@page "/assignment-assignment-sheet-overview"
@using Shared.Contracts
@using Shared
@using blazor.models
@using System.Net.Http.Json
@attribute [Authorize(Roles = Roles.Teacher)]
@inject HttpClient Http

<h1 class="title">Opgave & Opgavesæt oversigt</h1>

@if (!string.IsNullOrEmpty(status))
{
    <p>@status</p>
}

<div class="container">

    <div class="column">
        <button class="top-button">Liste af Opgavesæt (@sheets.Count)</button>

        <div class="box">
            @foreach (var s in sheets)
            {
                <div class="item @(selectedSheetId == s.Id ? "selected" : "")"
                     @onclick="() => selectedSheetId = s.Id"
                     @key="s.Id">
                    @s.Title — @s.Subject (@s.Year)
                </div>
            }
        </div>

        <button class="delete-button"
                disabled="@(selectedSheetId is null)"
                @onclick="DeleteSelectedSheet">
            Slet opgavesæt
        </button>
    </div>

    <div class="column">
        <button class="top-button">Liste af Opgaver (@assignments.Count)</button>

        <div class="box">
            @foreach (var a in assignments)
            {
                <div class="item @(selectedAssignmentId == a.Id ? "selected" : "")"
                     @onclick="() => selectedAssignmentId = a.Id"
                     @key="a.Id">
                    @a.Subject — @a.Topic (Opgave @a.Number)
                </div>
            }
        </div>

        <button class="delete-button"
                disabled="@(selectedAssignmentId is null)"
                @onclick="DeleteSelectedAssignment">
            Slet opgave
        </button>
    </div>

</div>

@code {
    private List<AssignmentSheetSummary> sheets = new();
    private List<Assignment> assignments = new();
    private Guid? selectedSheetId;
    private Guid? selectedAssignmentId;
    private string status = "";

    protected override async Task OnInitializedAsync() => await LoadAll();

    private async Task LoadAll()
    {
        try
        {
            sheets = await Http.GetFromJsonAsync<List<AssignmentSheetSummary>>("api/assignmentsheet") ?? new();
            var paged = await Http.GetFromJsonAsync<PagedResult<Assignment>>("api/assignment?pageSize=100");
            assignments = paged?.Items ?? new();
        }
        catch (Exception ex)
        {
            status = $"Indlæsning fejlede: {ex.Message}";
        }
    }

    private async Task DeleteSelectedSheet()
    {
        if (selectedSheetId is null) return;
        var response = await Http.DeleteAsync($"api/assignmentsheet/{selectedSheetId}");
        status = response.IsSuccessStatusCode
            ? "Opgavesæt slettet."
            : $"Sletning fejlede: {(int)response.StatusCode}";
        selectedSheetId = null;
        await LoadAll();
    }

    private async Task DeleteSelectedAssignment()
    {
        if (selectedAssignmentId is null) return;
        var response = await Http.DeleteAsync($"api/assignment/{selectedAssignmentId}");
        status = response.IsSuccessStatusCode
            ? "Opgave slettet."
            : $"Sletning fejlede: {(int)response.StatusCode}";
        selectedAssignmentId = null;
        await LoadAll();
    }

    public class AssignmentSheetSummary
    {
        public Guid Id { get; set; }
        public string Title { get; set; } = "";
        public string Subject { get; set; } = "";
        public string Level { get; set; } = "";
        public int Year { get; set; }
        public string Owner { get; set; } = "";
        public AssignmentSheetType Type { get; set; }
    }
}
